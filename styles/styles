.menu-horizontal{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15 px 30px;
    background-color: #2c3e50;
}
.menu-horizontal img{
    height: 35px;
}
.nav-links{
    display: flex;
    list-style: none;
    gap: 25px;
}
.nav-links a, .lang-links a{
    color: white;
    text-decoration: none;
    font-weight: bold;
}
.lang-links{
    display: flex;
    gap: 15px;
}
.menu-vertical{
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 600px;
    margin: 20px auto;
}
.manu-row{
    display: flex;
    justify-content: space-between;
    background-color: black;
    padding: 15px 25px;
    font-weight: bold;
}
.menu-row button{
background-color: rgb(255, 255, 255);
border: 1px solid #ccc;
padding: 8px 20px;
cursor: pointer;
font-weight: bold;
}
.center-page{
    display: flex;
    justify-content: center;
    align-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f0f2f5;
}
.centered-box{
    background-color: #718093;
    color: white;
    padding: 30px;
    border-radius: 8px;
    max-width: 400px;
    box-shadow: 0 4px 6px rgb(0 0 0 / 0.1);
}